# Copy to .env to override the defaults used by docker compose.
POSTGRES_USER=recife
POSTGRES_PASSWORD=recife
POSTGRES_DB=recife156
# Host port; 5433 avoids clashing with a local PostgreSQL on 5432
POSTGRES_PORT=5433
MONGO_PORT=27018

# Years of the 156 dataset to load (comma separated, 2024 or later).
YEARS=2024,2025

# Password of the read-only database user used by the "Pergunte aos dados" assistant.
ASSISTANT_DB_PASSWORD=assistant

# Anthropic API key for the assistant. Leave empty to run the dashboard without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
